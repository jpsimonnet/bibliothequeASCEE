{
  "name": "bibliotheque-11ty",
  "version": "1.0.0",
  "description": "Site statique pour catalogue de 7310 livres",
  "scripts": {
    "extract-ebooks": "node scripts/extract-ebooks.js",
    "start": "node scripts/extract-ebooks.js && NODE_OPTIONS='--max-old-space-size=4096' eleventy --serve",
    "build": "node scripts/extract-ebooks.js && NODE_OPTIONS='--max-old-space-size=4096' NODE_ENV=production eleventy --pathprefix=/bibliothequeASCEE/",
    "clean": "rm -rf _site"
  },
  "keywords": [
    "11ty",
    "bibliothèque",
    "livres"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@11ty/eleventy": "^2.0.1"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "csv-parse": "^5.6.0"
  }
}
