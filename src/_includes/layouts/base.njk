<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if title %}{{ title }} - {% endif %} La Bibiothèque de l'ASCEE 75</title>
  <meta name="description" content="{{ description or 'Catalogue de 7240 livres' }}">
  <link rel="stylesheet" href="{{ '/css/style.css' | url }}">
</head>
<body>

 

<div class="skiplinks">
      <nav role="navigation" aria-label="Accès rapide" class="container">
        <ul class="skiplinks__list">
          <li>
            <a  class="" href="#main">Contenu</a>
          </li>

          <li>
            <a  class="" href="#menu">Menu</a>
          </li>

          <li>
            <a  class="" href="#recherche">Rechercher</a>
          </li>

          <li>
            <a  class="" href="#footer"  >Pied de page</a>
          </li>
        </ul>
      </nav>
    </div>
  
  <header class="site-header">
    <nav class="nav-main" id="menu">
      <a href="{{ '/' | url }}" class="logo">📚 La Bibiothèque de l'ASCEE 75</a>
      <ul class="nav-list">
        <li><a class="btn-secondary" href="{{ '/' | url }}" title="Accueil">&#x1F3E0;</a></li>
        <li><a class="btn-secondary" href="{{ '/catalogue/' | url }}">Catalogue</a></li>
        <li><a class="btn-secondary" href="{{ '/categories/' | url }}">Cat&#233;gories</a></li>
        <li><a class="btn-secondary btn-numerique" href="{{ '/epub/' | url }}">Epubs</a></li>
        <li><a class="btn-secondary" href="{{ '/reservation/' | url }}">R&#233;servation</a></li>
        <li><a class="btn-secondary" href="{{ '/suggestions/' | url }}">Suggestions</a></li>
        <li><a class="btn-secondary" href="https://grist.numerique.gouv.fr/o/docs/sH5fAFqm9fRs/bibliotheque-ASCE/p/16">Votre compte</a></li>
      </ul>
    </nav>
  </header>

  <main id="main">
    {% block content %}
    {{ content | safe }}
    {% endblock %}
  </main>

  <footer class="site-footer" id="footer">
    <p>&copy; 2025 - Bibliothèque de l'ASCEE 75</p>
    <p>{{ livres.length }} livres physiques — {{ ebooks.length }} ebooks</p>
  </footer>

  <script>
    // Gérer les images manquantes avec le SVG par défaut
    document.addEventListener('DOMContentLoaded', () => {
      const defaultCover = '{{ "/images/0-livre-par-defaut.svg" | url }}';
      document.querySelectorAll('.livre-card-cover img, .livre-cover img').forEach(img => {
        img.addEventListener('error', function() {
          if (this.dataset.fallbackApplied) return;
          this.dataset.fallbackApplied = 'true';
          this.src = defaultCover;
        });
      });
    });
  </script>

</body>
</html>
