---
pagination:
  data: livres
  size: 1
  alias: livre
  addAllPagesToCollections: true
permalink: "/livre/{{ livre.id }}/"
tags: livre
eleventyComputed:
  title: "{{ livre.nom }}"
---
{% extends "layouts/base.njk" %}

{% block content %}
<article class="livre-detail">

  <nav class="breadcrumb">
    <a href="{{ '/' | url }}">Accueil</a> /
    <a href="{{ '/catalogue/' | url }}">Catalogue</a> /
    <span>{{ livre.nom }}</span>
  </nav>

  <div class="livre-grid">

    <div class="livre-cover">
      <img
        src="{{ ('/images/covers/' + livre.id + '.webp') | url }}"
        alt="Couverture de {{ livre.nom }}"
        loading="lazy"
        width="300"
        height="auto"
      >
    </div>

    <div class="livre-info">
      <h1>{{ livre.nom }}</h1>

      {% if livre.type %}
      <p class="livre-type">
        <span class="badge">{{ livre.type }}</span>
      </p>
      {% endif %}

      <p class="auteur">
        <strong>Auteur :</strong>
        {% if livre.auteur %}
          <a href="{{ ('/auteur/' + (livre.auteur | slugify) + '/') | url }}">{{ livre.auteur }}</a>
        {% else %}
          Auteur inconnu
        {% endif %}
      </p>

      {% set livreAvis = avis | avisPourLivre(livre.id) %}
      {% if livreAvis.length > 0 %}
      <p class="livre-note-moyenne">
        <span class="etoiles">{{ livreAvis | noteAverage | etoiles }}</span>
        <span class="note-chiffre">{{ livreAvis | noteAverage }}/5</span>
        <span class="note-count">({{ livreAvis.length }} avis)</span>
      </p>
      {% endif %}

      <div class="resume">
        <h2>Résumé</h2>
        {% if livre.resume %}
          <p>{{ livre.resume }}</p>
        {% else %}
          <p><em>Aucun résumé disponible.</em></p>
        {% endif %}
      </div>

      {% if livre.etagere %}
      <p class="livre-emplacement">
        <span class="emplacement-icone" aria-hidden="true">📍</span>
        <strong>Emplacement :</strong>
        <span class="emplacement-code">{{ livre.etagere }}</span>
      </p>
      {% endif %}

      <div class="actions">
         <a href="https://grist.numerique.gouv.fr/o/docs/sH5fAFqm9fRs/bibliotheque-ASCE/p/42#a1.s147.r{{ livre.id }}.c4"
           target="_blank"
           rel="noopener noreferrer"
           class="btn-availability">
          📋 Vérifier la disponibilité du livre
        </a>
        <button onclick="history.back()" class="btn-secondary">
          ← Retour
        </button>
      </div>
    </div>

  </div>

  {% set planEtagere = livre.etagere | etagerePlan %}
  {% if planEtagere %}
  {# Plan de localisation dans la bibliothèque #}
  <section class="section-plan" id="plan">
    <h2>Où trouver ce livre ?</h2>
    <p class="plan-legende">
      Rayonnage <strong>{{ planEtagere }}</strong> — emplacement <strong>{{ livre.etagere }}</strong>
    </p>
    <img
      class="plan-image"
      src="{{ ('/images/covers/' + planEtagere + '.png') | url }}"
      alt="Plan de la bibliothèque indiquant l'emplacement {{ livre.etagere }}"
      loading="lazy"
      onerror="this.closest('.section-plan').style.display='none'"
    >
  </section>
  {% endif %}

  {# Section avis #}
  <section class="section-avis" id="avis">

    {% if livreAvis.length > 0 %}
    <h2>Avis des lecteurs ({{ livreAvis.length }})</h2>
    <div class="liste-avis">
      {% for unAvis in livreAvis %}
      <article class="avis-card">
        <div class="avis-header">
          <span class="avis-nom">{{ unAvis.nom }}</span>
          <span class="avis-etoiles" aria-label="Note : {{ unAvis.note }} sur 5">{{ unAvis.note | etoiles }}</span>
          {% if unAvis.date %}
          <time class="avis-date" datetime="{{ unAvis.date }}">{{ unAvis.date }}</time>
          {% endif %}
        </div>
        <p class="avis-commentaire">{{ unAvis.commentaire }}</p>
      </article>
      {% endfor %}
    </div>
    {% else %}
    <h2>Avis des lecteurs</h2>
    <p class="avis-vide">Soyez le premier à donner votre avis sur ce livre !</p>
    {% endif %}

    <div class="avis-formulaire">
      <h3>Laisser un avis</h3>
      {% if config.gristFormAvisUrl and config.gristFormAvisUrl != "REMPLACER_PAR_URL_FORMULAIRE_GRIST" %}
      <iframe
        src="{{ config.gristFormAvisUrl }}?livre_id={{ livre.id }}"
        title="Formulaire pour laisser un avis sur {{ livre.nom }}"
        loading="lazy"
        style="border: none; width: 100%; min-height: 700px;"
      ></iframe>
      {% else %}
      <p class="avis-form-indisponible">
        <em>Le formulaire d'avis sera disponible prochainement.</em>
      </p>
      {% endif %}
    </div>

  </section>

</article>
{% endblock %}
