---
layout: layouts/base.njk
title: Accueil
---

<div class="home-hero">
  <h1>Bienvenue dans votre bibliothèque</h1>
</div>
<article class="encadre m-1 encadre-grid">
  <div>
    <h2>📅  Horaires de la bibliothèque</h2>
    <p><strong>La bibliothèque est ouverte :</strong></p>
    <ul>
      <li>Mardi de 12h30 à 14h</li>
      <li>Jeudi de 13h à 14h</li>
    </ul>
    
    <h2>📚 Pr&#234;ts de livres</h2>
    <p><strong>Vous pouvez emprunter :</strong></p>
        <ul>
      <li>5 livres</li>
      <li>pendant 4 semaines</li>
    </ul>

    <h2>📖 Nouveau : T&#233;l&#233;charger des epubs libres de droits</h2>
    <p>Nous vous proposons une s&#233;lection d'epubs libres de droits <a href="{{ '/epub/' | url }}">en t&#233;l&#233;chargement gratuit</a>. Red&#233;couvrez des livres d'auteurs qui ont travers&#233; le si&#232;cle.</p>

  </div>

  <img class="right fr-responsive-img"
       src="./images/bibliotheque.webp"
       alt="Photo de la bibliothèque"
       loading="lazy"
       width="250"
       height="150">
</article>


 <div class="search-advanced" id="recherche">
    <input
      type="search"
      id="globalSearch"
      placeholder="Rechercher parmi tous les livres..."
      autocomplete="off"
    >
    <div class="search-filters" id="searchFilters">
      <button class="filter-btn active" data-filter="tous">Tous</button>
      <button class="filter-btn" data-filter="physique">Livres physiques</button>
      <button class="filter-btn" data-filter="numerique">Ebooks</button>
    </div>
    <p class="search-info" id="searchInfo">Entrez au moins 2 caractères pour rechercher</p>
  </div>

  <div id="searchResults" class="livres-grid"></div>
  
  <div id="searchLoading" class="loading" style="display: none;">
    <p>Recherche en cours...</p>
  </div>

</div>

 
<script>
(function() {
  let booksData = [];
  const searchInput = document.getElementById('globalSearch');
  const searchResults = document.getElementById('searchResults');
  const searchInfo = document.getElementById('searchInfo');
  const searchLoading = document.getElementById('searchLoading');
  const imagesPath = '{{ "/images/covers/" | url }}';
  const defaultCover = '{{ "/images/0-livre-par-defaut.svg" | url }}';

  let currentFilter = 'tous';

  fetch('{{ "/search.json" | url }}')
    .then(response => response.json())
    .then(data => {
      booksData = data;
      const physiques = data.filter(b => b.source === 'physique').length;
      const numeriques = data.filter(b => b.source === 'numerique').length;
      searchInfo.textContent = `${data.length} livres disponibles (${physiques} physiques, ${numeriques} ebooks). Entrez au moins 2 caractères pour rechercher.`;
    })
    .catch(error => {
      searchInfo.textContent = 'Erreur de chargement des données.';
      console.error('Erreur:', error);
    });

  // Gestion des filtres
  document.querySelectorAll('.filter-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      currentFilter = btn.dataset.filter;
      performSearch();
    });
  });

  let searchTimeout;
  searchInput.addEventListener('input', () => {
    clearTimeout(searchTimeout);
    searchTimeout = setTimeout(performSearch, 300);
  });

  function performSearch() {
    const query = normalize(searchInput.value.trim());

    if (query.length < 2) {
      searchResults.innerHTML = '';
      const physiques = booksData.filter(b => b.source === 'physique').length;
      const numeriques = booksData.filter(b => b.source === 'numerique').length;
      searchInfo.textContent = `${booksData.length} livres disponibles (${physiques} physiques, ${numeriques} ebooks). Entrez au moins 2 caractères pour rechercher.`;
      return;
    }

    searchLoading.style.display = 'block';

    let filtered = booksData;
    if (currentFilter !== 'tous') {
      filtered = booksData.filter(b => b.source === currentFilter);
    }

    const results = filtered.filter(book => {
      return normalize(book.titre).includes(query) ||
             normalize(book.auteur).includes(query) ||
             (book.resume && normalize(book.resume).includes(query));
    }).slice(0, 100);

    searchLoading.style.display = 'none';
    displayResults(results, query);
  }

  function displayResults(results, query) {
    if (results.length === 0) {
      searchInfo.textContent = `Aucun résultat pour "${query}"`;
      searchResults.innerHTML = '';
      return;
    }

    searchInfo.textContent = `${results.length} résultat${results.length > 1 ? 's' : ''} trouvé${results.length > 1 ? 's' : ''} pour "${query}"`;
    
    searchResults.innerHTML = results.map(book => {
      const isEbook = book.source === 'numerique';
      const coverSrc = isEbook ? (book.cover || defaultCover) : `${imagesPath}${book.id}.webp`;
      const sourceBadge = isEbook
        ? '<span class="search-source-badge search-source-badge--numerique">Télécharger</span>'
        : '<span class="search-source-badge search-source-badge--physique">À emprunter</span>';
      const cardClass = isEbook ? 'livre-card livre-card--numerique' : 'livre-card';

      return `
      <article class="${cardClass}">
        <a href="${book.url}">
          <div class="livre-card-cover">
            <img
              src="${coverSrc}"
              alt="${escapeHtml(book.titre)}"
              loading="lazy"
              width="200"
              height="300"
              data-book-id="${book.id}"
            >
          </div>
          <div class="livre-card-info">
            ${sourceBadge}
            ${book.type ? `<span class="livre-card-type">${escapeHtml(book.type)}</span>` : ''}
            <h3>${highlightText(escapeHtml(book.titre), query)}</h3>
            <p class="auteur">${highlightText(escapeHtml(book.auteur), query)}</p>
          </div>
        </a>
      </article>
    `;
    }).join('');
    
    // Gérer les images manquantes
    const defaultCover = '{{ "/images/0-livre-par-defaut.svg" | url }}';
    document.querySelectorAll('#searchResults .livre-card-cover img').forEach(img => {
      img.addEventListener('error', function() {
        if (this.dataset.fallbackApplied) return;
        this.dataset.fallbackApplied = 'true';
        this.src = defaultCover;
      });
    });
  }

  function highlightText(text, query) {
    const map = {'a':'[aàâäáãå]','e':'[eéèêëæ]','i':'[iîïíì]','o':'[oôöóòõøœ]','u':'[uùûüú]','c':'[cç]','n':'[nñ]','y':'[yÿý]'};
    const pattern = [...query].map(ch => map[ch] || escapeRegex(ch)).join('');
    const regex = new RegExp(`(${pattern})`, 'gi');
    return text.replace(regex, '<mark>$1</mark>');
  }

  function normalize(str) {
    return (str || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
  }

  function escapeRegex(string) {
    return string.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  }

  function escapeHtml(text) {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }
})();
</script>

<section class="home-featured" >
  <h2>Nouveautés</h2>
  <div class="livres-grid">
    {% set toutesNouveautes = [] %}
    {% for livre in livres %}
      {% if livre.nouveaute == "true" %}
        {% set toutesNouveautes = (toutesNouveautes.push(livre), toutesNouveautes) %}
      {% endif %}
    {% endfor %}
    {% set nouveautes = toutesNouveautes | sort(attribute="id") | reverse | limit(10) %}
    
    {% if nouveautes.length == 0 %}
      <p>Aucune nouveauté pour le moment. Nombre total de livres parcourus : {{ livres.length }}</p>
    {% else %}
      {% for livre in nouveautes %}
        <article class="livre-card">
          <a href="{{ ('/livre/' + livre.id + '/') | url }}">
            <div class="livre-card-cover">
              <img 
                src="{{ ('/images/covers/' + livre.id + '.webp') | url }}"
                alt="Couverture de {{ livre.nom }}"
                loading="lazy"
                width="200"
                height="300"
              >
            </div>
            <div class="livre-card-info">
              <h3>{{ livre.nom | truncate(50) }}</h3>
              <p class="auteur">{{ livre.auteur | auteurFormat }}</p>
            </div>
          </a>
        </article>
      {% endfor %}
    {% endif %}
  </div>
  
  <div class="home-cta">
    <a href="{{ '/catalogue/' | url }}" class="btn-primary btn-large">Voir tout le catalogue</a>
  </div>
</section>

{% if avis.length > 0 %}
<section class="home-featured home-avis">
  <h2>Derniers avis des lecteurs</h2>
  <div class="derniers-avis-grille">
    {% for unAvis in avis | limit(6) %}
      {% set leLivre = null %}
      {% for livre in livres %}
        {% if livre.id == unAvis.livre_id %}{% set leLivre = livre %}{% endif %}
      {% endfor %}
      {% if leLivre %}
      <article class="dernier-avis-card">
        <a href="{{ ('/livre/' + unAvis.livre_id + '/#avis') | url }}" class="dernier-avis-cover-link">
          <img
            src="{{ ('/images/covers/' + unAvis.livre_id + '.webp') | url }}"
            alt="Couverture de {{ leLivre.nom }}"
            loading="lazy"
            width="200"
            height="280"
            onerror="this.src='{{ '/images/0-livre-par-defaut.svg' | url }}'"
          >
        </a>
        <div class="dernier-avis-body">
          <a href="{{ ('/livre/' + unAvis.livre_id + '/#avis') | url }}" class="dernier-avis-titre">{{ leLivre.nom | truncate(50) }}</a>
          <span class="dernier-avis-auteur">{{ leLivre.auteur | auteurFormat }}</span>
          <span class="avis-etoiles" aria-label="Note : {{ unAvis.note }} sur 5">{{ unAvis.note | etoiles }}</span>
          <p class="avis-commentaire">{{ unAvis.commentaire | truncate(250) }}</p>
          <span class="avis-signature">— {{ unAvis.nom }}</span>
        </div>
      </article>
      {% endif %}
    {% endfor %}
  </div>
  <div class="home-cta">
    <a href="{{ '/avis/' | url }}" class="btn-primary">Voir tous les avis</a>
  </div>
</section>
{% endif %}

<section class="home-featured home-numerique">
  <h2>Biblioth&#232;que d'epubs libres de droits</h2>
  <p>Nous vous proposons une s&#233;lection d'epubs libres de droits en t&#233;l&#233;chargements gratuits. Red&#233;couvrez des livres d'auteurs qui ont travers&#233; le si&#232;cle.</p>

  {% set auteursSelection = [
    "Alexandre Dumas", "Honoré de Balzac", "Victor Hugo", "Émile Zola",
    "Jules Verne", "Guy de Maupassant", "Gustave Flaubert", "Molière",
    "Voltaire", "Marcel Proust", "Stendhal", "Jean-Jacques Rousseau",
    "Pierre Corneille", "Jean de La Fontaine", "Charles Baudelaire",
    "Antoine de Saint-Exupéry", "Albert Camus", "André Gide", "Colette", "Boris Vian",
    "Arthur Conan Doyle", "Charles Dickens", "Edgar Allan Poe",
    "William Shakespeare", "Fédor Mikhaïlovitch Dostoïevski", "Léon Tolstoï",
    "Jack London", "Robert Louis Stevenson", "Herbert George Wells",
    "Oscar Wilde", "Stefan Zweig", "Howard Phillips Lovecraft",
    "Jane Austen", "Mark Twain", "Thomas Mann", "George Orwell",
    "Maurice Leblanc", "Gaston Leroux", "George Sand",
    "Alphonse Daudet", "Rudyard Kipling"
  ] %}

  <h3>Notre s&#233;lection d'auteurs</h3>
  <div class="auteurs-selection">
    {% for nom in auteursSelection | sortByLastName %}
      {% set count = 0 %}
      {% for ebook in ebooks %}
        {% if ebook.auteur == nom %}{% set count = count + 1 %}{% endif %}
      {% endfor %}
      <a href="{{ ('/epub/auteur/' + nom | slugify + '/') | url }}" class="auteur-tag">{{ nom }} ({{ count }})</a>
    {% endfor %}
  </div>

  <div class="home-cta">
    <a href="{{ '/epub/' | url }}" class="btn-primary btn-large btn-numerique">Voir tous les ebooks</a>
  </div>

  <article class="encadre-logiciels">
    <h3>Quelques logiciels pour lire les epubs</h3>
    <p>Les fichiers epub se lisent avec une application de lecture. Voici quelques applications gratuites :</p>
    <ul>
      <li><strong>Windows</strong> : <a href="https://calibre-ebook.com/download" target="_blank">Calibre</a> (gratuit, open source) ou <a href="https://www.sumatrapdfreader.org/download-free-pdf-viewer" target="_blank">Sumatra PDF</a></li>
      <li><strong>Mac</strong> : Apple Livres (pr&#233;install&#233;) ou <a href="https://calibre-ebook.com/download" target="_blank">Calibre</a></li>
      <li><strong>iPhone / iPad</strong> : Apple Livres (pr&#233;install&#233;)</li>
      <li><strong>Android</strong> : <a href="https://play.google.com/store/apps/details?id=org.readera" target="_blank">ReadEra</a> (gratuit)</li>
    </ul>
  </article>
</section>